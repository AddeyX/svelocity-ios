{
  "name": "svelocity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "svelocity": "dist/src/cli.js",
    "svelocity-language-server": "dist/src/language-server.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "svelocity": "node dist/src/cli.js",
    "language-server": "node dist/src/language-server.js --stdio"
  },
  "dependencies": {
    "svelte": "5.57.2",
    "typescript": "5.9.3",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-textdocument": "1.0.15"
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  }
}
